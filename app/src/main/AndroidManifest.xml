<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- INTERNET is the only permission this app requests: GitHub API +
         ZIP download. Storage is handled exclusively through the Storage
         Access Framework (system folder picker + persisted tree URI).
         No READ/WRITE_EXTERNAL_STORAGE, no MANAGE_EXTERNAL_STORAGE.
         (AndroidX core contributes its generated
         DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION for its own internal
         dynamic receivers; the app declares nothing else.) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="Crystal Nova Manager"
        android:theme="@style/Theme.CrystalNova"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:icon="@drawable/ic_launcher">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>
</manifest>
