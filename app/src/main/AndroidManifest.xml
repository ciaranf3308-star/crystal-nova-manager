<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- INTERNET: GitHub API + ZIP/APK downloads. Storage is handled
         through the Storage Access Framework (system folder picker +
         persisted tree URI) plus MANAGE_EXTERNAL_STORAGE for the game
         importer's direct Downloads scan (see below). No
         READ/WRITE_EXTERNAL_STORAGE.
         (AndroidX core contributes its generated
         DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION for its own internal
         dynamic receivers; the app declares nothing else.) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- MANAGE_EXTERNAL_STORAGE ("All files access"): the game importer
         scans the normal shared Downloads directory directly via
         java.io.File. Android 11+ refuses to grant the Downloads root
         through the SAF tree picker ("can't use this folder — to protect
         your privacy"), so without this the user is forced into a
         Downloads/GameImport subfolder workaround. The system Settings
         page grants it; the importer UI shows GRANTED / NOT GRANTED and
         offers an OPEN SETTINGS action. When not granted (or on
         API < 30) the importer falls back to the SAF subfolder grant
         automatically. ROM-root writes stay SAF-only. This is a
         sideloaded personal utility; Play policy is irrelevant. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!-- REQUEST_INSTALL_PACKAGES: the self-updater hands the downloaded
         APK to Android's system package installer. The system always
         shows its own install prompt, and on Android 8+ the user grants
         "install unknown apps" for this app once, in Settings. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- FOREGROUND_SERVICE: the game importer runs long archive imports
         in a foreground service (type dataSync) with an ongoing
         notification, so the run survives the app being backgrounded.
         Storage: SAF grants + MANAGE_EXTERNAL_STORAGE for the direct
         Downloads scan; no READ/WRITE_EXTERNAL_STORAGE. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Package visibility (Android 11+). ES-DE
         (org.es_de.frontend / the Galaxy-store variant) for the OPEN
         ES-DE launcher check. Used only for getLaunchIntentForPackage
         so the UI can show an honest INSTALLED / NOT INSTALLED state.
         No data is read from these apps. -->
    <queries>
        <package android:name="org.es_de.frontend" />
        <package android:name="org.es_de.frontend.galaxy" />
    </queries>

    <application
        android:name=".CrystalManagerApp"
        android:label="Crystal Nova Manager"
        android:theme="@style/Theme.CrystalNova"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:extractNativeLibs="true"
        android:icon="@drawable/ic_launcher">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Serves the downloaded update APK to the system package
             installer. Scoped to the updater cache dir only. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/filepaths" />
        </provider>

        <!-- Game importer: foreground dataSync service for long import
             runs. Not exported; started only from the app's own review
             screen. -->
        <service
            android:name=".importer.ImportService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

    </application>
</manifest>
