<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- INTERNET: GitHub API + ZIP/APK downloads. Storage is handled
         exclusively through the Storage Access Framework (system folder
         picker + persisted tree URI). No READ/WRITE_EXTERNAL_STORAGE,
         no MANAGE_EXTERNAL_STORAGE.
         (AndroidX core contributes its generated
         DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION for its own internal
         dynamic receivers; the app declares nothing else.) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- REQUEST_INSTALL_PACKAGES: the self-updater hands the downloaded
         APK to Android's system package installer. The system always
         shows its own install prompt, and on Android 8+ the user grants
         "install unknown apps" for this app once, in Settings. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Package visibility (Android 11+). ES-DE
         (org.es_de.frontend / the Galaxy-store variant) for the OPEN
         ES-DE launcher check. Used only for getLaunchIntentForPackage
         so the UI can show an honest INSTALLED / NOT INSTALLED state.
         No data is read from these apps. -->
    <queries>
        <package android:name="org.es_de.frontend" />
        <package android:name="org.es_de.frontend.galaxy" />
    </queries>

    <application
        android:label="Crystal Nova Manager"
        android:theme="@style/Theme.CrystalNova"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:icon="@drawable/ic_launcher">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Serves the downloaded update APK to the system package
             installer. Scoped to the updater cache dir only. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/filepaths" />
        </provider>

        <!-- Read-only Crystal library bridge for the Crystal Launcher.
             The Manager is the sole owner of storage permission; the
             launcher (io.crystalnova.launcher, enforced in code via the
             calling UID) reads config.json, index.json, profiles.json and
             media through this provider. A signature-level permission is
             not possible: the two APKs are signed with different
             certificates. grantUriPermissions is on so specific URIs
             (ROMs) can later be handed to emulator apps. -->
        <provider
            android:name=".provider.CrystalDataProvider"
            android:authorities="io.crystalnova.manager.crystaldata"
            android:exported="true"
            android:grantUriPermissions="true" />

    </application>
</manifest>
